PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/construction
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://maple-construction-app-zeta.vercel.app

# Public owner sign-up is disabled for client deployments.
ALLOW_OWNER_REGISTRATION=false
NODE_ENV=development
# Initial setup: provide OWNER_NAME, OWNER_EMAIL and OWNER_PASSWORD privately,
# run npm run create-owner, then remove those temporary variables.
